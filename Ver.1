  { id:'tv2',             ic:'📺', t:'テレビが さわいだら すぐ{逃|に}げる!' },
  { id:'tv3',             ic:'🌊', t:'ほんものの{水|みず}は まってくれない!' },
  { id:'karaburi',        ic:'⚾', t:'{逃|に}げの からぶりは「{素振|すぶ}り」!' },
  { id:'sunny',           ic:'🌞', t:'なにも おこらない{日|ひ}も ある' },
  { id:'lull-escape',     ic:'🌤', t:'{雨|あめ}の あとも すぐは あんしん できない!' },
  { id:'flood-taifu',     ic:'🌀', t:'{台風|たいふう}は {予報|よほう}で {逃|に}げられる!' },
  { id:'flood-ooame',     ic:'🌧', t:'{赤|あか}（レベル3）で もう にげどき!' },
  { id:'flood-dosha',     ic:'⛰', t:'{土砂災害|どしゃさいがい}は テレビより{早|はや}い!' },
  { id:'floodlull-taifu', ic:'🌀', t:'{台風一過|たいふういっか}にも わなが ある!' },
  { id:'floodlull-ooame', ic:'🌧', t:'{雨|あめ}が やんでも {川|かわ}は ふえる!' },
  { id:'floodlull-dosha', ic:'⛰', t:'{土砂災害|どしゃさいがい}は {雨|あめ}の あとにも くる!' },
  { id:'jishin-ok',       ic:'🙆', t:'かんがえる{前|まえ}に{頭|あたま}を まもる!' },
  { id:'jishin-ng',       ic:'🪑', t:'{家具|かぐ}の{固定|こてい}が「にげどき」の かわり' },
  { id:'jishin-early',    ic:'🚪', t:'{地震|じしん}は いつ くるか わからない' },
];
function loadZukan(){ try{ return JSON.parse(localStorage.getItem(ZKEY))||[]; }catch(e){ return []; } }
function recordZukan(id){
  const z=loadZukan();
  if(z.includes(id)) return false;
  z.push(id);
  try{ localStorage.setItem(ZKEY, JSON.stringify(z)); }catch(e){}
  return true;
}
function showZukan(){
  const got=loadZukan();
  $('zkcount').innerHTML=R(`あつめた おしえ: ${got.length} / ${ZUKAN.length}`);
  $('zkgrid').innerHTML=ZUKAN.map(c=>{
    return got.includes(c.id)
      ? `<div class="zkcard"><span class="ic">${c.ic}</span><span class="t">${R(c.t)}</span></div>`
      : `<div class="zkcard locked"><span class="ic">❓</span><span class="t">？？？ — あそんで みつけよう!</span></div>`;
  }).join('');
  go('zukan');
}

