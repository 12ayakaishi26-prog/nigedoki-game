<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-fullscreen">
<title>にげどきチキンレース</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; touch-action:manipulation; user-select:none; -webkit-user-select:none; }
  html,body {
    height:100%; height:100vh; height:100dvh;
    overflow:hidden; overscroll-behavior:none;
    font-family:"Hiragino Maru Gothic ProN","BIZ UDGothic","Yu Gothic",sans-serif;
  }
  body { background:linear-gradient(#7ec8f7,#cfeeff); transition:background 1s; }
  body.sky1 { background:linear-gradient(#9db8c9,#cfe0ea); }
  body.sky2 { background:linear-gradient(#6e7f8d,#a9b8c2); }
  body.sky3 { background:linear-gradient(#3c4650,#6e7a85); }
  body.flooded { background:linear-gradient(#1a3550,#2c567e); }

  #app { height:100%; height:100vh; height:100dvh; display:flex; flex-direction:column; align-items:center; }
  .screen { display:none; width:100%; max-width:820px; height:100%; flex-direction:column; align-items:center; padding:16px; }
  .screen.on { display:flex; }

  h1 { font-size:min(9vw,64px); color:#fff; text-shadow:0 3px 0 rgba(0,0,0,.25); margin-top:10vh; }
  .sub { color:#fff; font-size:min(4.5vw,26px); text-shadow:0 2px 0 rgba(0,0,0,.2); margin:12px 0 40px; text-align:center; }

  rt { font-size:.5em; font-weight:normal; letter-spacing:0; }
  button { font-family:inherit; border:none; border-radius:20px; cursor:pointer; }
  .big { font-size:min(6vw,34px); padding:20px 44px; margin:10px; background:#fff; color:#2a6db5; box-shadow:0 5px 0 rgba(0,0,0,.2); font-weight:bold; }
  .big:active { transform:translateY(3px); box-shadow:0 2px 0 rgba(0,0,0,.2); }

  .picker { display:flex; flex-wrap:wrap; justify-content:center; gap:12px; margin:14px 0; }
  .pick { font-size:min(5.5vw,28px); padding:16px 22px; background:#fff; border-radius:16px; box-shadow:0 4px 0 rgba(0,0,0,.15); font-weight:bold; color:#333; }
  .pick.sel { background:#ffd94d; }
  .stagecard { width:min(44vw,330px); text-align:left; line-height:1.5; }
  .stagecard small { color:#666; font-weight:normal; }

  /* ---- play screen ---- */
  #clouds { height:70px; font-size:52px; letter-spacing:8px; margin-top:4px; min-height:70px; }
  #tv { width:100%; background:#222; border-radius:16px; padding:10px 14px; color:#fff; border:6px solid #444; }
  #tvband { display:inline-block; padding:3px 12px; border-radius:8px; font-weight:bold; font-size:min(4vw,20px); margin-bottom:4px; color:#000; background:#fff; }
  #tvmsg { font-size:min(4.6vw,24px); line-height:1.4; min-height:2.8em; }
  #cue { color:#fff; font-size:min(4.5vw,22px); text-shadow:0 2px 2px rgba(0,0,0,.5); min-height:1.6em; margin:8px 0; font-weight:bold; }
  #candy { font-size:min(7vw,40px); color:#fff; text-shadow:0 2px 0 rgba(0,0,0,.3); margin:6px 0; font-weight:bold; }
  #tapbtn { font-size:min(7vw,40px); padding:28px 40px; background:#ffd94d; color:#7a4a00; width:min(80vw,480px); }
  #runbtn { font-size:min(7vw,40px); padding:22px 40px; background:#37b24d; color:#fff; width:min(80vw,480px); margin-top:14px; }
  .gain { position:fixed; font-size:34px; font-weight:bold; color:#fff; text-shadow:0 2px 3px rgba(0,0,0,.5); pointer-events:none; animation:rise 1s forwards; }
  @keyframes rise { to { transform:translateY(-90px); opacity:0; } }

  #flood { position:fixed; left:0; right:0; bottom:0; height:0; background:linear-gradient(#4aa3df,#1c5a8f); transition:height 1.4s ease-in; z-index:50; overflow:hidden; }
  #flood .waves { font-size:44px; white-space:nowrap; }
  body.shake #app { animation:shk .12s infinite; }
  @keyframes shk { 25%{transform:translate(4px,2px)} 50%{transform:translate(-4px,-2px)} 75%{transform:translate(3px,-3px)} }

  /* EEW */
  #eew { position:fixed; inset:0; display:none; flex-direction:column; align-items:center; justify-content:center; background:rgba(160,0,0,.88); z-index:60; }
  #eew.on { display:flex; animation:blink .4s infinite; }
  @keyframes blink { 50% { background:rgba(120,0,0,.88); } }
  #eew h2 { color:#fff; font-size:min(8vw,46px); margin-bottom:24px; }
  #protbtn { font-size:min(8vw,44px); padding:30px 50px; background:#ffd94d; color:#7a4a00; font-weight:bold; }
  #eewbar { width:min(70vw,420px); height:16px; background:rgba(255,255,255,.3); border-radius:8px; margin-top:26px; }
  #eewbar div { height:100%; width:100%; background:#fff; border-radius:8px; }

  /* dojo */
  #scr-result { overflow-y:auto; overscroll-behavior:contain; -webkit-overflow-scrolling:touch; }
  #dojo { background:#fff8ec; border:6px solid #c98a2b; border-radius:24px; padding:16px; width:100%; margin-top:1vh; }
  #dojo .head { font-size:min(4.6vw,22px); font-weight:bold; color:#8a5a10; margin-bottom:8px; }
  #dojomain { font-size:min(6.6vw,36px); font-weight:bold; color:#b3541e; text-align:center; line-height:1.5; margin:4px 0 14px; }
  .tl { display:flex; align-items:flex-start; background:#fff; border-radius:16px; padding:12px 6px 10px; margin-bottom:14px; }
  .tlstep { flex:1; text-align:center; }
  .tlstep .ic { font-size:min(9vw,44px); display:block; }
  .tlstep .lb { font-size:min(3vw,15px); color:#666; display:block; margin-top:2px; }
  .tlstep .lvl { height:9px; border-radius:5px; margin:6px 10px 0; border:1px solid rgba(0,0,0,.08); }
  .tlstep .youb { display:inline-block; background:#37b24d; color:#fff; border-radius:10px; font-size:min(3.4vw,16px); font-weight:bold; padding:2px 10px; margin-top:6px; }
  .tlstep.bad .youb { background:#e03131; }
  .tlarrow { align-self:center; font-size:min(5vw,26px); color:#c98a2b; padding-top:8px; }
  #dojo .owl { font-size:min(11vw,60px); float:left; margin-right:12px; }
  #dojo .say { font-size:min(4.2vw,21px); line-height:1.65; color:#333; overflow:hidden; }
  #dojoscore { font-size:min(5.5vw,30px); font-weight:bold; color:#2a6db5; margin:14px 0 4px; text-align:center; }
  .btnrow { margin-top:auto; padding:10px 0 4px; display:flex; flex-wrap:wrap; justify-content:center; }

  /* howto */
  .howbox { background:#fff8ec; border:6px solid #c98a2b; border-radius:24px; padding:18px; width:100%; margin-top:2vh; }
  .howtitle { font-size:min(5.4vw,27px); font-weight:bold; color:#8a5a10; margin-bottom:8px; }
  .howlead { font-size:min(4.6vw,23px); line-height:1.6; color:#333; margin-bottom:12px; }
  .hrow { display:flex; gap:12px; align-items:flex-start; background:#fff; border-radius:12px; padding:8px 12px; margin-bottom:8px; }
  .hrow span { font-size:min(7vw,34px); line-height:1.2; }
  .hrow div { font-size:min(4.2vw,20px); line-height:1.55; color:#333; }
  /* ranking */
  #scr-rank { overflow-y:auto; overscroll-behavior:contain; -webkit-overflow-scrolling:touch; }
  .rkhead { color:#fff; font-weight:bold; font-size:min(4.6vw,22px); text-shadow:0 2px 0 rgba(0,0,0,.25); margin:14px 0 0; align-self:flex-start; }
  table { width:100%; border-collapse:collapse; background:rgba(255,255,255,.92); border-radius:16px; overflow:hidden; margin-top:14px; }
  th,td { padding:10px 8px; font-size:min(4.6vw,22px); text-align:center; border-bottom:2px solid #e5eef5; color:#333; }
  th { background:#2a6db5; color:#fff; }
  .staffbtn { background:none; color:rgba(255,255,255,.7); font-size:14px; margin-top:18px; text-decoration:underline; }

  #mute { position:fixed; top:10px; right:10px; font-size:26px; background:rgba(255,255,255,.6); border-radius:50%; width:52px; height:52px; z-index:70; }

  /* zukan（おしえのずかん） */
  #scr-zukan { overflow-y:auto; overscroll-behavior:contain; -webkit-overflow-scrolling:touch; }
  .zkgrid { width:100%; display:flex; flex-direction:column; gap:8px; margin-top:12px; }
  .zkcard { display:flex; align-items:center; gap:12px; background:rgba(255,255,255,.92); border-radius:14px; padding:10px 14px; }
  .zkcard .ic { font-size:min(7vw,32px); }
  .zkcard .t { font-size:min(4.4vw,21px); font-weight:bold; color:#333; line-height:1.4; text-align:left; }
  .zkcard.locked { background:rgba(255,255,255,.45); }
  .zkcard.locked .t { color:#777; font-weight:normal; }
  .zknew { margin-top:10px; font-size:min(4.6vw,22px); font-weight:bold; color:#1c7c33; background:#e6f7ec; border:2px solid #37b24d; border-radius:12px; padding:8px 14px; display:none; }
  .zknew.on { display:block; }

  /* ---- スマホ幅(iPad/PCの見た目には影響させない): 縦の余白・パディングを詰めて画面内に収める ---- */
  @media (max-width:600px){
    .screen { padding:10px 16px; }
    h1 { margin-top:4vh; }
    .sub { margin:8px 0 18px; }
    .big { padding:14px 28px; margin:6px; }
    .picker { margin:8px 0; gap:8px; }
    .pick { padding:10px 14px; }
    .stagecard { width:min(42vw,300px); }

    #clouds { height:50px; min-height:50px; font-size:38px; margin-top:2px; }
    #tv { padding:8px 10px; }
    #tvband { padding:2px 10px; margin-bottom:2px; }
    #tvmsg { min-height:2.2em; }
    #cue { min-height:1.2em; margin:4px 0; }
    #candy { margin:4px 0; }
    #tapbtn { padding:18px 30px; }
    #runbtn { padding:16px 30px; margin-top:14px; }

    /* 音量ボタンを小さくし、全幅ボックスで始まる画面には上の逃げ場を作る（重なり防止） */
    #mute { width:40px; height:40px; font-size:18px; }
    #scr-howto, #scr-result { padding-top:54px; }

    .howbox { padding:10px; margin-top:0; }
    .howtitle { margin-bottom:4px; }
    .howlead { margin-bottom:6px; }
    .hrow { padding:5px 10px; margin-bottom:4px; gap:8px; }
    .hrow div { line-height:1.35; }

    #dojo { padding:12px; margin-top:0; }
    .tl { padding:8px 4px 6px; margin-bottom:8px; }
    #dojomain { margin:2px 0 8px; }
    #dojoscore { margin:8px 0 4px; }
  }

  /* ---- さらに狭い幅: ステージカードは2列だと窮屈なので1列にする ---- */
  @media (max-width:380px){
    .stagecard { width:88vw; }
  }
</style>
</head>
<body>
<button id="mute">🔊</button>
<div id="app">

  <div id="scr-title" class="screen on">
    <h1>にげどき<br>チキンレース</h1>
    <p class="sub"><ruby>お菓子<rt>おかし</rt></ruby>を あつめよう。<br>でも、<ruby>逃<rt>に</rt></ruby>げおくれたら ぜんぶ ながされる!</p>
    <button class="big" onclick="go('name')">はじめる</button>
    <button class="big" onclick="showRanking()">ランキング</button>
    <button class="big" onclick="showZukan()">📖 おしえの ずかん</button>
  </div>

  <div id="scr-name" class="screen">
    <p class="sub" style="margin-top:4vh"><ruby>名前<rt>なまえ</rt></ruby>を えらんでね</p>
    <div class="picker" id="colors"></div>
    <div class="picker" id="animals"></div>
    <p class="sub" id="nameview" style="margin:8px 0 6px; font-size:min(6.5vw,34px)"></p>
    <button class="big" id="nameok" onclick="go('howto')" disabled style="opacity:.4">これで いく!</button>
  </div>

  <div id="scr-howto" class="screen">
    <div class="howbox" id="howbox"></div>
    <button class="big" onclick="go('stage')">わかった! ステージへ</button>
  </div>

  <div id="scr-stage" class="screen">
    <p class="sub" style="margin-top:3vh">ステージを えらんでね</p>
    <div class="picker" id="stages"></div>
  </div>

  <div id="scr-play" class="screen">
    <div id="clouds"></div>
    <div id="tv"><span id="tvband"></span><div id="tvmsg"></div></div>
    <div id="cue"></div>
    <div id="candy">🍬 × 0</div>
    <button id="tapbtn">🍬 <ruby>お菓子<rt>おかし</rt></ruby>を ひろう</button>
    <button id="runbtn">🏃 <ruby>逃<rt>に</rt></ruby>げる!</button>
  </div>

  <div id="scr-result" class="screen">
    <div id="dojo">
      <div class="head" id="dojohead">🏯 おしえて! フクロウ<ruby>先生<rt>せんせい</rt></ruby></div>
      <div id="dojomain"></div>
      <div id="dojoviz"></div>
      <span class="owl">🦉</span>
      <div class="say" id="dojosay"></div>
    </div>
    <div id="dojoscore"></div>
    <div class="zknew" id="dojonew">📖 あたらしい おしえを おぼえた! ずかんに とうろく!</div>
    <div class="btnrow">
      <button class="big" onclick="showRanking()">ランキングを<ruby>見<rt>み</rt></ruby>る</button>
      <button class="big" onclick="go('title')">タイトルへ</button>
    </div>
  </div>

  <div id="scr-rank" class="screen">
    <p class="sub" style="margin-top:2vh">🏆 <ruby>逃<rt>に</rt></ruby>げきった<ruby>人<rt>ひと</rt></ruby>たち</p>
    <p class="sub" style="margin:0; font-size:min(3.6vw,18px)">おなじ ステージ・おなじ てんかいの<ruby>人<rt>ひと</rt></ruby>どうしで くらべるよ</p>
    <div id="rankwrap" style="width:100%"></div>
    <button class="big" onclick="go('title')">タイトルへ</button>
    <button class="staffbtn" onclick="clearRanking()">スタッフ用: 記録をぜんぶ消す</button>
  </div>

  <div id="scr-zukan" class="screen">
    <p class="sub" style="margin-top:2vh">📖 おしえの ずかん</p>
    <p class="sub" id="zkcount" style="margin:0; font-size:min(3.6vw,18px)"></p>
    <div class="zkgrid" id="zkgrid"></div>
    <button class="big" onclick="go('title')" style="margin:14px 0">タイトルへ</button>
  </div>

</div>
<div id="flood"><div class="waves">🌊🌊🌊🌊🌊🌊🌊🌊🌊🌊🌊🌊🌊🌊</div></div>
<div id="eew"><h2>⚠ <ruby>緊急地震速報<rt>きんきゅうじしんそくほう</rt></ruby> ⚠</h2><button id="protbtn">🙆 <ruby>頭<rt>あたま</rt></ruby>を まもる!!</button><div id="eewbar"><div id="eewfill"></div></div></div>

<script>
'use strict';
/* {漢字|かんじ} 記法を <ruby> に変換する */
const R = s => s.replace(/\{([^|}]+)\|([^}]+)\}/g, '<ruby>$1<rt>$2</rt></ruby>');
/* ================= data ================= */
// 令和8年5月29日運用開始の「新たな防災気象情報」準拠:
// 情報名にレベル数字を冠し、レベル4相当は「危険警報」。{H} はステージの災害種別に置換
// 気象庁の防災気象情報(msg前半)と市町村の避難情報(帯と「🏘 まちから」以降)は公式には別の情報のため、
// 混ぜて1つの発表のように表示しない。帯=警戒レベル(内閣府の5段階)、読み上げ=気象庁→市町村の順
const LEVELS = [
  { band:'', bandBg:'#fff', msg:'こんにちは! きょうも いい{天気|てんき}ですね。' },
  { band:'{警戒|けいかい}レベル1 {早期注意情報|そうきちゅういじょうほう}', bandBg:'#f0f0f0', msg:'このあと{天気|てんき}が くずれる かもしれません。' },
  { band:'{警戒|けいかい}レベル2 {注意報|ちゅういほう}', bandBg:'#f5e642', msg:'レベル2 {H}{注意報|ちゅういほう}が でました。' },
  { band:'{警戒|けいかい}レベル3 {高齢者等避難|こうれいしゃとうひなん}', bandBg:'#ff2800', msg:'レベル3 {H}{警報|けいほう}が でました。<br>🏘 まちから「{警戒|けいかい}レベル3 {高齢者等避難|こうれいしゃとうひなん}」: {高齢者等|こうれいしゃとう}、{避難|ひなん}に{時間|じかん}が かかる{人|ひと}は{避難|ひなん}!' },
  { band:'{警戒|けいかい}レベル4 {避難指示|ひなんしじ}', bandBg:'#aa00aa', msg:'レベル4 {H}{危険警報|きけんけいほう}が でました。<br>🏘 まちから「{警戒|けいかい}レベル4 {避難指示|ひなんしじ}」: きけんな ばしょから ぜんいん{避難|ひなん}!!' },
  { band:'{警戒|けいかい}レベル5 {緊急安全確保|きんきゅうあんぜんかくほ}', bandBg:'#0c000c', msg:'レベル5 {H}{特別警報|とくべつけいほう}!!<br>🏘 まちから「{警戒|けいかい}レベル5 {緊急安全確保|きんきゅうあんぜんかくほ}」: {命|いのち}の{危険|きけん}! ただちに{安全確保|あんぜんかくほ}!!' },
];
// レベル3以降のバンドは白文字にする
const DARKBANDS = [3,4,5];

// pClear: 空振り(雲が消えて何も起こらない)確率 / pDelayed: 晴れたあとに災害が来る確率 / 残りが通常ラン
const STAGES = {
  taifu: { icon:'🌀', name:'{台風|たいふう}', stars:'★', desc:'テレビが{早|はや}めに おしえてくれる',
    hazard:'{大雨|おおあめ}', pClear:.20, pDelayed:.05,
    cloudChance:.16, flood:{0:0,1:0,2:.05,3:.35}, tvLevel:c=>Math.min(5,c+2), cues:{},
    lullCue:'{空|そら}は はれたのに、{川|かわ}の{水|みず}は まだ ふえてる…' },
  ooame: { icon:'🌧', name:'{大雨|おおあめ}・{川|かわ}', stars:'★★', desc:'テレビを{見|み}ていれば わかる',
    hazard:'{氾濫|はんらん}', pClear:.20, pDelayed:.08,
    cloudChance:.21, flood:{0:0,1:0,2:.12,3:.45}, tvLevel:c=>Math.min(5,c+1), cues:{},
    lullCue:'{雨|あめ}は やんだのに、{川|かわ}は まだ にごってる…' },
  dosha: { icon:'⛰', name:'{土砂災害|どしゃさいがい}', stars:'★★★', desc:'テレビより{早|はや}く くる…',
    hazard:'{土砂災害|どしゃさいがい}', pClear:.15, pDelayed:.12,
    cloudChance:.26, flood:{0:0,1:.05,2:.25,3:.65}, tvLevel:c=>Math.min(5,Math.max(1,c)),
    cues:{1:'{山|やま}のほうから ゴゴゴ…と{音|おと}がする',2:'{川|かわ}の{水|みず}が ちゃいろく にごってきた!',3:'じめんから{水|みず}が しみでてきた!!'},
    lullCue:'{雨|あめ}は やんだのに、{地面|じめん}から{水|みず}が しみでてる…' },
  jishin: { icon:'🏠', name:'{地震|じしん}', stars:'★★★★', desc:'よこくなしで くる{災害|さいがい}', special:true },
};

const COLORS = ['あかい','あおい','きいろい','みどりの','きんの','にじいろの'];
const ANIMALS = [['🐸','カエル'],['🦉','フクロウ'],['🐱','ネコ'],['🐶','イヌ'],['🐢','カメ'],['🦊','キツネ'],['🐰','ウサギ'],['🐼','パンダ']];

/* ================= state ================= */
const S = { name:'', color:null, animal:null, stageId:null, candy:0, taps:0, clouds:0,
            sinceCloud:0, alive:true, over:false, tvLv:0, escapedAt:null, eewTimer:null, lastTapAt:0 };

/* ================= helpers ================= */
const $ = id => document.getElementById(id);
function go(name){
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('on'));
  $('scr-'+name).classList.add('on');
  if(name==='title'){ resetSky(); }
}
function resetSky(){ document.body.className=''; $('flood').style.height='0'; setRain(0); }

/* ================= audio (WebAudio, 失敗しても無視) ================= */
let AC=null, rainGain=null, muted=false;
function ensureAudio(){
  if(muted) return;
  try{
    if(!AC){
      AC = new (window.AudioContext||window.webkitAudioContext)();
      const len = AC.sampleRate*2, buf = AC.createBuffer(1,len,AC.sampleRate);
      const d = buf.getChannelData(0);
      for(let i=0;i<len;i++) d[i]=Math.random()*2-1;
      const src=AC.createBufferSource(); src.buffer=buf; src.loop=true;
      const filt=AC.createBiquadFilter(); filt.type='lowpass'; filt.frequency.value=900;
      rainGain=AC.createGain(); rainGain.gain.value=0;
      src.connect(filt).connect(rainGain).connect(AC.destination); src.start();
    }
    if(AC.state==='suspended') AC.resume();
  }catch(e){}
}
function setRain(v){ try{ if(rainGain) rainGain.gain.linearRampToValueAtTime(muted?0:v, AC.currentTime+.5); }catch(e){} }
function beep(freq,dur,when){ if(muted) return; try{
  const o=AC.createOscillator(), g=AC.createGain();
  o.frequency.value=freq; o.type='square';
  g.gain.setValueAtTime(.12, AC.currentTime+(when||0));
  g.gain.exponentialRampToValueAtTime(.001, AC.currentTime+(when||0)+dur);
  o.connect(g).connect(AC.destination); o.start(AC.currentTime+(when||0)); o.stop(AC.currentTime+(when||0)+dur+.05);
}catch(e){} }
function tvChime(){ beep(880,.15); beep(660,.15,.18); }
function eewSound(){ for(let i=0;i<4;i++){ beep(933,.22,i*.5); beep(740,.22,i*.5+.25);} }
$('mute').onclick=()=>{ muted=!muted; $('mute').textContent=muted?'🔇':'🔊'; setRain(muted?0:S.clouds*.06); };

/* ================= name picker ================= */
function buildPickers(){
  COLORS.forEach((c,i)=>{
    const b=document.createElement('button'); b.className='pick'; b.textContent=c;
    b.onclick=()=>{ S.color=c; sel('colors',i); nameCheck(); };
    $('colors').appendChild(b);
  });
  ANIMALS.forEach((a,i)=>{
    const b=document.createElement('button'); b.className='pick'; b.textContent=a[0]+a[1];
    b.onclick=()=>{ S.animal=a; sel('animals',i); nameCheck(); };
    $('animals').appendChild(b);
  });
  Object.entries(STAGES).forEach(([id,st])=>{
    const b=document.createElement('button'); b.className='pick stagecard';
    b.innerHTML=R(`${st.icon} <b>${st.name}</b> ${st.stars}<br><small>${st.desc}</small>`);
    b.onclick=()=>startStage(id);
    $('stages').appendChild(b);
  });
}
function sel(boxId,idx){ [...$(boxId).children].forEach((b,i)=>b.classList.toggle('sel',i===idx)); }
function nameCheck(){
  if(S.color&&S.animal){
    S.name=S.color+S.animal[1];
    $('nameview').textContent=S.animal[0]+' '+S.name;
    $('nameok').disabled=false; $('nameok').style.opacity=1;
  }
}

/* ================= game ================= */
function startStage(id){
  ensureAudio();
  S.stageId=id; S.candy=0; S.taps=0; S.clouds=0; S.sinceCloud=0;
  S.alive=true; S.over=false; S.tvLv=0; S.escapedAt=null; S.endKind=null;
  // ランの種類を秘密裏に決める: normal(必ず来る) / clear(空振り) / delayed(晴れたあとに来る)
  S.runType='normal'; S.phase='build'; S.peak=2+Math.floor(Math.random()*2);
  if(id!=='jishin'){
    const r=Math.random(), st=STAGES[id];
    if(r<st.pClear) S.runType='clear';
    else if(r<st.pClear+st.pDelayed) S.runType='delayed';
  }
  resetSky();
  $('candy').textContent='🍬 × 0'; $('clouds').textContent=''; $('cue').textContent='';
  setTv(id==='jishin'?0:0);
  go('play');
  clearInterval(S.idleTimer);
  S.lastTapAt = Date.now();
  if(id==='jishin'){
    // 8〜16タップ後、または12〜22秒後の早い方でEEW
    S.eewTapAt = 8+Math.floor(Math.random()*9);
    S.eewTimer = setTimeout(fireEEW, 12000+Math.random()*10000);
  }else{
    // 放置しても約5秒ごとに天気は進む（飴は増えない）。タップ直後の重複進行はさせない
    S.idleTimer = setInterval(()=>{ if(!S.over && Date.now()-S.lastTapAt>4500) worldTick(); }, 5000);
  }
}
function setTv(lv){
  if(lv===S.tvLv && S.taps>0) return;
  const changed = lv!==S.tvLv;
  S.tvLv=lv;
  const L=LEVELS[lv];
  const hz = (STAGES[S.stageId] && STAGES[S.stageId].hazard) || '';
  $('tvband').innerHTML = R(L.band || '📺 {天気|てんき}ニュース');
  $('tvband').style.background = L.bandBg;
  $('tvband').style.color = DARKBANDS.includes(lv) ? '#fff' : '#000';
  $('tvmsg').innerHTML = '📺 '+R(L.msg.replace('{H}', hz));
  if(changed && lv>=2) tvChime();
}
$('tapbtn').onclick = () => {
  if(S.over) return;
  ensureAudio();
  S.lastTapAt = Date.now();
  S.taps++;
  // 地震ステージは1タップの実入りを小さくする（リスクが低いぶんランキングを占領しないように）
  const gain = S.stageId==='jishin' ? Math.max(1, 3-Math.floor(S.taps/5)) : Math.max(1, 6-Math.floor(S.taps/3));
  S.candy += gain;
  $('candy').textContent = '🍬 × '+S.candy;
  floatGain('+'+gain);
  if(S.stageId==='jishin'){ if(S.taps>=S.eewTapAt) fireEEW(); return; }
  worldTick();
};
// 天気の進行1ステップ。タップと放置タイマーの両方から呼ぶ
// （タップを止めても災害は止まらない。「水は待ってくれない」と実装を一致させるため、放置=安全にしない）
function worldTick(){
  if(S.over || S.stageId==='jishin') return;
  const st = STAGES[S.stageId];
  if(S.phase==='build'){
    // 雲の発生（5ステップ雲なしなら強制）
    S.sinceCloud++;
    if(S.clouds<3 && (Math.random()<st.cloudChance || S.sinceCloud>=5)){
      addCloud(st);
      if(S.runType!=='normal' && S.clouds>=S.peak){ S.phase='clearing'; return; }
    }
    // 濁流判定は通常ランのみ（clear/delayed はいったん晴れに向かう）
    if(S.runType==='normal'){
      const risk = st.flood[S.clouds]||0;
      if(Math.random()<risk) doFlood();
    }
  }else if(S.phase==='clearing'){
    if(Math.random()<.5){
      S.clouds--;
      renderSky();
      if(S.clouds<=0){
        if(S.runType==='clear'){ endSunny(); }
        else{ enterLull(st); }
      }else{
        setTv(st.tvLevel(S.clouds));
      }
    }
  }else if(S.phase==='lull'){
    if(Math.random()<.35) doFlood();
  }
}
function addCloud(st){
  S.clouds++; S.sinceCloud=0;
  renderSky();
  setTv(st.tvLevel(S.clouds));
  if(st.cues[S.clouds]){ $('cue').innerHTML='💭 '+R(st.cues[S.clouds]); }
  if(S.stageId==='dosha'&&S.clouds>=2){ document.body.classList.add('shake'); setTimeout(()=>document.body.classList.remove('shake'),600); }
}
function renderSky(){
  $('clouds').textContent = '⛈'.repeat(Math.max(0,S.clouds));
  document.body.className = S.clouds>0 ? 'sky'+S.clouds : '';
  setRain(Math.max(0,S.clouds)*.06);
}
function setTvSunny(){
  S.tvLv=0;
  $('tvband').innerHTML=R('📺 {天気|てんき}ニュース');
  $('tvband').style.background='#fff'; $('tvband').style.color='#000';
  $('tvmsg').innerHTML='📺 '+R('{雨|あめ}は やみました。よかったですね。');
}
function endSunny(){
  S.over=true; S.endKind='sunny';
  renderSky(); setTvSunny(); $('cue').textContent='';
  setTimeout(()=>showResult(true), 900);
}
function enterLull(st){
  S.phase='lull';
  renderSky(); setTvSunny();
  $('cue').innerHTML='💭 '+R(st.lullCue);
}
$('runbtn').onclick = () => {
  if(S.over) return;
  // 飴連打中の指すべり誤タップを無視（意図した「にげる」は連打をやめてから押される）
  if(Date.now()-S.lastTapAt < 300) return;
  if(S.stageId==='jishin'){ // 地震ステージで「にげる」= ふつうに終了
    S.over=true; clearTimeout(S.eewTimer); S.escapedAt=-1; showResult(true); return;
  }
  S.over=true; S.escapedAt=Math.max(0,S.clouds);
  S.endKind = S.phase==='lull' ? 'escape-lull' : 'escape';
  showResult(true);
};
function floatGain(txt){
  const el=document.createElement('div'); el.className='gain'; el.textContent=txt;
  const r=$('tapbtn').getBoundingClientRect();
  el.style.left=(r.left+r.width/2-20+(Math.random()*60-30))+'px'; el.style.top=(r.top-10)+'px';
  document.body.appendChild(el); setTimeout(()=>el.remove(),1000);
}
function doFlood(){
  S.over=true; S.alive=false;
  S.endKind = S.phase==='lull' ? 'flood-lull' : 'flood';
  setRain(.25); beep(220,.6);
  document.body.classList.add('flooded');
  $('flood').style.height='100%';
  setTimeout(()=>showResult(false), 1700);
}
/* ---- EEW（地震ステージ） ---- */
function fireEEW(){
  if(S.over||S.eewFired) return;
  S.eewFired=true; clearTimeout(S.eewTimer);
  S.over=true; // タップ停止
  eewSound();
  document.body.classList.add('shake');
  $('eew').classList.add('on');
  $('eewfill').style.transition='width 2.6s linear'; $('eewfill').style.width='100%';
  requestAnimationFrame(()=>{ $('eewfill').style.width='0%'; });
  const t=setTimeout(()=>{ endEEW(false); }, 2600);
  $('protbtn').onclick=()=>{ clearTimeout(t); endEEW(true); };
}
function endEEW(ok){
  $('eew').classList.remove('on');
  document.body.classList.remove('shake');
  S.eewFired=false; S.alive=ok;
  if(!ok){ S.candy=0; }
  showResult(ok);
}

/* ================= result / dojo ================= */
// 雨ステージの図: はれ→くも1→くも2→くも3→こうずい。下の色バーはテレビの警戒レベル色
function rainViz(st, youAt, died){
  const icons=['☀️','⛅','🌧','⛈'], labels=['はれ','くも1','くも2','くも3'];
  let html='<div class="tl">';
  for(let c=0;c<=3;c++){
    const lv = c===0 ? 0 : st.tvLevel(c);
    const you = !died && youAt===c;
    html+=`<div class="tlstep"><span class="ic">${icons[c]}</span><span class="lb">${labels[c]}</span><div class="lvl" style="background:${LEVELS[lv].bandBg}"></div>${you?'<span class="youb">🏃 きみ!</span>':''}</div>`;
  }
  html+=`<div class="tlstep${died?' bad':''}"><span class="ic">🌊</span><span class="lb">こうずい</span><div class="lvl" style="background:#0c000c"></div>${died?'<span class="youb">😵 きみ</span>':''}</div>`;
  return html+'</div>';
}
// 空振りランの図: 雲が育って→晴れた。stayed=true なら最後まで粘った人
function clearViz(st, youAt, stayed){
  const icons=['☀️','⛅','🌧','⛈'], labels=['はれ','くも1','くも2','くも3'];
  let html='<div class="tl">';
  for(let c=0;c<=S.peak;c++){
    const lv = c===0 ? 0 : st.tvLevel(c);
    const you = !stayed && youAt===c;
    html+=`<div class="tlstep"><span class="ic">${icons[c]}</span><span class="lb">${labels[c]}</span><div class="lvl" style="background:${LEVELS[lv].bandBg}"></div>${you?'<span class="youb">🏃 きみ!</span>':''}</div>`;
  }
  html+=`<div class="tlstep"><span class="ic">🌞</span><span class="lb">はれた!</span><div class="lvl" style="background:#fff"></div>${stayed?'<span class="youb">😊 きみ</span>':''}</div>`;
  return html+'</div>';
}
// 晴れ後災害ランの図: 雲→晴れ→そのあと災害。escaped=true なら晴れの間に逃げた人
function delayedViz(st, escaped){
  const lv = st.tvLevel(S.peak);
  let html='<div class="tl">';
  html+=`<div class="tlstep"><span class="ic">⛈</span><span class="lb">おおあれ</span><div class="lvl" style="background:${LEVELS[lv].bandBg}"></div></div>`;
  html+=`<div class="tlstep"><span class="ic">🌞</span><span class="lb">はれた…?</span><div class="lvl" style="background:#fff"></div>${escaped?'<span class="youb">🏃 きみ!</span>':''}</div>`;
  html+=`<div class="tlstep${escaped?'':' bad'}"><span class="ic">🌊</span><span class="lb">そのあと!</span><div class="lvl" style="background:#0c000c"></div>${escaped?'':'<span class="youb">😵 きみ</span>'}</div>`;
  return html+'</div>';
}
// 地震ステージの図: kind = 'early'(速報前に帰った) | 'ok'(間に合った) | 'ng'(間に合わず)
function jishinViz(kind){
  const step=(ic,lb,badge,bad)=>`<div class="tlstep${bad?' bad':''}"><span class="ic">${ic}</span><span class="lb">${lb}</span>${badge?`<span class="youb">${badge}</span>`:''}</div>`;
  const ar='<div class="tlarrow">➡</div>';
  let html='<div class="tl">';
  if(kind==='early'){ html+=step('🍬','あそんでた')+ar+step('🚪','おうちへ','🏃 きみ!')+ar+step('🏠❓','じしんは いつ?'); }
  else if(kind==='ok'){ html+=step('🍬','あそんでた')+ar+step('📳','そくほう!!')+ar+step('🙆','あたまを まもった','🏃 きみ!'); }
  else { html+=step('🍬','あそんでた')+ar+step('📳','そくほう!!')+ar+step('🪑💥','まにあわず…','😵 きみ',true); }
  return html+'</div>';
}
function showResult(survived){
  clearInterval(S.idleTimer);
  resetSkyLater();
  const st=STAGES[S.stageId];
  let say='', score='', main='', viz='', card='';
  if(S.stageId==='jishin'){
    if(S.escapedAt===-1){
      card='jishin-early';
      main='{地震|じしん}は いつ くるか わからない';
      viz=jishinViz('early');
      say='{地震|じしん}が くる{前|まえ}に おうちに{帰|かえ}ったね。それも あり! でも{地震|じしん}は いつ くるか だれにも わからない。だから <b>ふだんの そなえ</b>が すべてなんだ。';
      survived=true;
    }else if(survived){
      card='jishin-ok';
      main='かんがえる{前|まえ}に{頭|あたま}を まもる!';
      viz=jishinViz('ok');
      say='{速報|そくほう}から すうびょうで{頭|あたま}を まもれた! すごい! {地震|じしん}には「にげどき」が ない。<b>{速報|そくほう}が なったら かんがえる{前|まえ}に うごく</b>。きょうの きみは それが できたよ。';
    }else{
      card='jishin-ng';
      main='{家具|かぐ}の{固定|こてい}が「にげどき」の かわり';
      viz=jishinViz('ng');
      say='たなが たおれてきちゃった…。でも だいじょうぶ、ここは れんしゅうの どうじょう。{地震|じしん}は よこくなしで くる。だから <b>おうちの{家具|かぐ}の{固定|こてい}</b>を きょう チェックしてみよう。それが{地震|じしん}の「にげどき」の かわりだよ。';
    }
  }else if(survived){
    if(S.endKind==='sunny'){
      card='sunny';
      main='なにも おこらない{日|ひ}も ある';
      viz=clearViz(st,null,true);
      say='きょうは くもが きえた。けいほうが でても、さいがいが おこらない ことも あるんだ。でも どれが ほんものかは、ふる{前|まえ}には だれにも わからない。だから「からぶりでも{逃|に}げる」が せいかい なんだよ。';
    }else if(S.endKind==='escape-lull'){
      card='lull-escape';
      main='{雨|あめ}の あとも すぐは あんしん できない!';
      viz=delayedViz(st,true);
      say='{雨|あめ}が やんでも、{川|かわ}の{水|みず}は あとから ふえるし、{土砂災害|どしゃさいがい}は{地面|じめん}が{水|みず}を すった あとに おこりやすい。はれた あとの ようじんが できた きみは、かなり すごい!';
    }else if(S.runType==='clear'){
      card='karaburi';
      main='{逃|に}げの からぶりは「{素振|すぶ}り」!';
      viz=clearViz(st,S.escapedAt,false);
      say='この あと、{雨|あめ}は やんだ。「{逃|に}げて そんした」…? ちがうよ。{避難|ひなん}の からぶりは <b>{素振|すぶ}り</b> — ほんばんの ための りっぱな れんしゅう。つぎも おなじように{逃|に}げて OK!';
    }else{
      const c=S.escapedAt;
      viz=rainViz(st,c,false);
      card = c<=1 ? 'early' : (c===2 ? 'tv2' : 'tv3');
      if(c<=1){
        main='{逃|に}げるのに「{早|はや}すぎる」は ない!';
        say=`あめぐも${c===0?'ゼロ':'1つ'}で{逃|に}げた! <b>まんてん!</b> げんじつでも それでいい。{お菓子|おかし}も たくさん{持|も}ち{帰|かえ}れたね。`;
      }else if(c===2){
        main='テレビが さわいだら すぐ{逃|に}げる!';
        say='いい はんだん! {空|そら}が くらくなって テレビが さわぎだしたら、まよわず{逃|に}げる。それが せいかい。';
      }else{
        main='ほんものの{水|みず}は まってくれない!';
        say='ギリギリ〜!! {逃|に}げきったのは おみごと。でも ほんものの こうずいは まってくれない ことも あるよ。つぎは <b>1つ{早|はや}く</b> {逃|に}げてみよう。';
      }
    }
  }else if(S.endKind==='flood-lull'){
    card='floodlull-'+S.stageId;
    main={
      taifu:'{台風一過|たいふういっか}にも わなが ある!',
      ooame:'{雨|あめ}が やんでも {川|かわ}は ふえる!',
      dosha:'{土砂災害|どしゃさいがい}は {雨|あめ}の あとにも くる!',
    }[S.stageId];
    viz=delayedViz(st,false);
    say='はれたのに ながされちゃった…。じつは これ、ほんとうに ある パターン。{上流|じょうりゅう}の{雨|あめ}は おくれて{川|かわ}に とどくし、{水|みず}を すった{地面|じめん}は {雨|あめ}が やんだ あとに くずれる ことが あるんだ。「はれた = あんぜん」じゃ ないんだよ。';
  }else{
    card='flood-'+S.stageId;
    viz=rainViz(st,null,true);
    const missTv = st.tvLevel(Math.max(1,S.clouds));
    const tvline = missTv>=3 ? `ながされる{前|まえ}、テレビは「<b>${LEVELS[missTv].band}</b>」って いってたよ。` : '';
    main={
      taifu:'{台風|たいふう}は {予報|よほう}で {逃|に}げられる!',
      ooame:'{赤|あか}（レベル3）で もう にげどき!',
      dosha:'{土砂災害|どしゃさいがい}は テレビより{早|はや}い!',
    }[S.stageId];
    const lesson = {
      taifu:'{台風|たいふう}は なんにちも{前|まえ}から わかる{災害|さいがい}。よほうが でたら、{早|はや}めに{逃|に}げる じゅんびを しよう。',
      ooame:'レベルは{赤|あか}（3 {高齢者等避難|こうれいしゃとうひなん}）→ むらさき（4 {避難指示|ひなんしじ}）の じゅんに あがる。{赤|あか}は「{高齢者等|こうれいしゃとう}、{避難|ひなん}に{時間|じかん}が かかる{人|ひと}は{逃|に}げる」の あいず、むらさきは「ぜんいん{逃|に}げる」。でも きょうみたいに、むらさきを またずに{水|みず}が くる ことも あるんだよ。',
      dosha:'{土砂災害|どしゃさいがい}は テレビより{早|はや}く くることが ある。「{山|やま}の{音|おと}」「にごった{川|かわ}」が ほんとうの サインだよ。',
    }[S.stageId];
    say=`ながされちゃった…。でも だいじょうぶ、ここは れんしゅうの どうじょう! ${tvline}${lesson}`;
  }
  if(survived){
    score=`{記録|きろく}: 🍬 × ${S.candy} → ランキングに とうろく!`;
    addRanking(S.name, S.stageId, kindOf(), S.candy);
  }else{
    score='こんかいは{記録|きろく}なし。{記録|きろく}は ぶじだった{人|ひと}の もの!';
  }
  $('dojomain').innerHTML=R(main);
  $('dojoviz').innerHTML=viz;
  $('dojosay').innerHTML=R(say);
  $('dojoscore').innerHTML=R(score);
  // おしえのずかん: 初めて見た教訓なら登録してバッジを出す
  $('dojonew').classList.toggle('on', !!card && recordZukan(card));
  go('result');
}
function resetSkyLater(){ setTimeout(()=>{ document.body.className=''; $('flood').style.height='0'; setRain(0); }, 400); }

/* ================= ranking ================= */
const KEY='nigedoki-ranking';
// ランの展開(通常/空振り/晴れのあと災害)。同条件どうしでのみ競わせる
function kindOf(){ return S.stageId==='jishin' ? '通常' : ({normal:'通常', clear:'空振り', delayed:'晴れのあと災害'})[S.runType]; }
function loadRank(){ try{ return JSON.parse(localStorage.getItem(KEY))||[]; }catch(e){ return []; } }
function addRanking(name,stageId,kind,candy){
  const list=loadRank();
  list.push({name,stageId,kind,candy,ts:Date.now()});
  // 条件（ステージ×展開）ごとに上位5件だけ残す。全体を件数で切ると希少展開の上位記録が先に消えるため
  const kept=[];
  Object.keys(STAGES).forEach(sid=>{
    ['通常','空振り','晴れのあと災害'].forEach(k=>{
      kept.push(...list.filter(r=>r.stageId===sid&&r.kind===k).sort((a,b)=>b.candy-a.candy).slice(0,5));
    });
  });
  // 保存に失敗してもリザルト表示は続行する
  try{ localStorage.setItem(KEY, JSON.stringify(kept)); }catch(e){}
}
function showRanking(){
  const list=loadRank().filter(r=>r.kind&&STAGES[r.stageId]);
  const KINDS=['通常','空振り','晴れのあと災害'];
  let html='';
  Object.keys(STAGES).forEach(sid=>{
    KINDS.forEach(k=>{
      const rows=list.filter(r=>r.stageId===sid&&r.kind===k).sort((a,b)=>b.candy-a.candy).slice(0,5);
      if(!rows.length) return;
      const st=STAGES[sid];
      const label = sid==='jishin' ? R(st.name) : R(st.name)+'・'+k;
      html+=`<p class="rkhead">${st.icon} ${label}</p>`;
      html+=`<table><thead><tr><th>${R('{順位|じゅんい}')}</th><th>${R('{名前|なまえ}')}</th><th>🍬</th></tr></thead><tbody>`;
      html+=rows.map((r,i)=>`<tr><td>${i+1}</td><td>${r.name}</td><td>${r.candy}</td></tr>`).join('');
      html+='</tbody></table>';
    });
  });
  $('rankwrap').innerHTML = html || '<p class="sub" style="margin-top:20px">まだ だれも いないよ。いちばんのりに なろう!</p>';
  go('rank');
}
function clearRanking(){
  const a=prompt('スタッフよう しつもん: あなたの すきな キャラは?');
  if(a===null) return;
  if(/^(2|２|二)号ライダー系$/.test(a.trim())){
    if(confirm('ランキングと ずかんを ぜんぶ けします。いい?')){ localStorage.removeItem(KEY); localStorage.removeItem(ZKEY); showRanking(); }
  }else{
    alert('ここは さわらないでね!');
  }
}

